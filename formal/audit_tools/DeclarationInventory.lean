import CFG
import Lean.Data.Json.FromToJson.Basic
import Lean.Util.FoldConsts
import Lean.Util.CollectAxioms
import Lean.Elab.Command
import Lean.Data.Format

/-!
  Environment inventory for the CFG audit.

  The selection boundary is the *source module* (`CFG.*`), obtained from the
  kernel module table.  Declaration names are deliberately not used as the
  boundary: private, generated, and declarations outside the CFG namespace
  can still be emitted by a CFG source module.

  This is an inventory, not a proof of completeness.  It sees declarations
  serialized in the current imported environment.  Declarations generated by
  later commands, opaque extension data, and compiler-only auxiliary names
  that are absent from `ModuleData.constants` are outside this report.
-/

open Lean
open Lean.Elab
open Lean.Elab.Command

def moduleIsCFG (n : Name) : Bool := (`CFG == n) || (`CFG).isPrefixOf n

def sourceModule (env : Environment) (n : Name) : Option Name := do
  let i ← env.getModuleIdxFor? n
  env.allImportedModuleNames[i]?

def kind (c : ConstantInfo) : String :=
  match c with
  | .axiomInfo _   => "axiom"
  | .defnInfo _    => "definition"
  | .thmInfo _     => "theorem"
  | .opaqueInfo _  => "opaque"
  | .quotInfo _    => "quot"
  | .inductInfo _  => "inductive"
  | .ctorInfo _    => "constructor"
  | .recInfo _     => "recursor"

def jsonNames (xs : NameSet) : Json :=
  Json.arr <| xs.toList.toArray.map (fun n => Json.str n.toString)

def entry (env : Environment) (moduleName : Name) (c : ConstantInfo)
    (axioms : Array Name) (typeText : String) : Json :=
  let unresolved := c.getUsedConstantsAsSet.filter fun n => env.find? n |>.isNone
  Json.mkObj [
    ("name", Json.str c.name.toString),
    ("type", Json.str typeText),
    ("source_module", Json.str moduleName.toString),
    ("kind", Json.str (kind c)),
    ("is_theorem", Json.bool c.isTheorem),
    ("is_axiom", Json.bool c.isAxiom),
    ("is_private", Json.bool (isPrivateName c.name)),
    ("is_private_or_generated", Json.bool (isPrivateName c.name || c.name.isInternalOrNum)),
    ("recursive_axioms", Json.arr <| axioms.map (fun n => Json.str n.toString)),
    ("unresolved_direct_dependencies", jsonNames unresolved)
  ]

def inventory (env : Environment) : CommandElabM Json := do
  let modules := env.allImportedModuleNames
  let total : Nat := env.constants.fold (fun n _ _ => n + 1) 0
  logInfo m!"declaration inventory: scanning {total} environment constants"
  let candidates := env.constants.fold (init := #[]) fun out _ c =>
    match sourceModule env c.name with
    | some moduleName => if moduleIsCFG moduleName then out.push (moduleName, c) else out
    | none => out
  logInfo m!"declaration inventory: selected {candidates.size} CFG-source declarations"
  let entries ← candidates.foldlM (init := #[]) fun out (moduleName, c) => do
    let axioms ← collectAxioms c.name
    let typeFmt ← runTermElabM fun _ => Meta.ppExpr c.type
    let typeText := Lean.Std.Format.pretty' typeFmt
    if out.size % 100 == 0 then
      logInfo m!"declaration inventory: collected {out.size}/{candidates.size} axiom closures"
    pure <| out.push (entry env moduleName c axioms typeText)
  let cfgModuleCount := modules.foldl (init := 0) fun n m => if moduleIsCFG m then n + 1 else n
  pure <| Json.mkObj [
    ("status", Json.str "ENVIRONMENT_INVENTORY"),
    ("selection", Json.str "source module CFG and CFG.*"),
    ("main_module", Json.str env.mainModule.toString),
    ("module_count", toJson modules.size),
    ("cfg_module_count", toJson cfgModuleCount),
    ("source_modules", Json.arr <| (modules.filter moduleIsCFG).map
      (fun n => Json.str n.toString)),
    ("declaration_count", toJson entries.size),
    ("type_rendering", Json.str "Lean.Meta.ppExpr pretty rendering; implicit parameters may be omitted"),
    ("coverage_boundary", Json.str "ModuleData.constants only; compiler-only auxiliary names and post-import declarations are not covered"),
    ("declarations", Json.arr entries)
  ]

syntax "run_declaration_inventory" : command

elab_rules : command
  | `(run_declaration_inventory) => do
    let env ← getEnv
    logInfo (← inventory env).pretty

run_declaration_inventory
